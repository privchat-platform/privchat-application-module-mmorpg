include "scene_common.fbs";
namespace privchat.mmorpg.scene;

/// 服务端算出的权威路径;客户端按同一路径本地插值,不依赖高频下行。
table MovementStarted {
  entity_id:ulong;
  movement_seq:uint;
  entity_version:ulong;
  path_id:ulong;
  authoritative_start_position:Vec2Fixed;   // 权威起点,非客户端上报位置
  path_points:[Vec2Fixed];
  start_time_ms:ulong;
  speed:int;                                 // 定点
  navigation_version:uint;                   // 防新旧导航数据混算
}

/// 仅在碰撞/阻挡/速度变化/偏差超阈值时下发。
/// **必须带 movement_seq 与 entity_version** —— 否则迟到的旧纠偏会覆盖新路径。
table MovementCorrected {
  entity_id:ulong;
  movement_seq:uint;
  entity_version:ulong;
  corrected_position:Vec2Fixed;
  reason:CorrectionReason;

  /// 纠偏后的运动参数。**必须携带** —— 只给一个坐标的话,
  /// 客户端知道"被拉回哪里"却不知道"接下来怎么走",无法继续权威插值。
  /// 若纠偏后处于静止(BLOCKED),path_points 为空且 speed 为 0。
  corrected_path_id:ulong;
  corrected_path_points:[Vec2Fixed];
  corrected_speed:int;            // 定点,1 = 1/1000 单位每秒
  effective_time_ms:ulong;        // 该参数从何时起生效(服务端时钟)
}

table AoiEnter  { entities:[EntityState]; }
table AoiUpdate { entities:[EntityState]; }
table AoiLeave  { entity_ids:[ulong]; }

/// 主动收敛:ENTER/LEAVE 丢失时客户端**无从察觉**,故周期下发完整视野集合,
/// 客户端按同一 revision 原子增删(见 §3.2.1)。
table AoiRebase {
  aoi_revision:ulong;
  entity_ids:[ulong];
  entities:[EntityState];     // 可选:携带完整投影省一次拉取
}

/// 所有人一致的低频场景事件(天气/公告/NPC 刷新)。
/// payload 语义属玩法,协议只负责搬运。
table PublicSceneChanged {
  scene_version:ulong;
  payload_kind:uint;
  payload:[ubyte];
}

union SceneEventPayload {
  MovementStarted, MovementCorrected,
  AoiEnter, AoiUpdate, AoiLeave, AoiRebase,
  PublicSceneChanged
}

table SceneEvent {
  event_id:ulong;
  stream_seq:ulong;        // PUBLIC 取 public_scene_seq;PRIVATE 取 private_aoi_revision
  server_time_ms:ulong;
  critical:bool;           // 服务端标注能否安全跳过
  payload:SceneEventPayload;
}

/// wire 上的一帧是一个**批次**,不是一条事件。
/// 批次**不跨可见性**:PUBLIC 走 Room Publish,PRIVATE 走定向 transfer。
///
/// **可见性与载荷的强制矩阵**(违反即视野泄露):
///
/// | visibility | 允许的 payload | recipient_role_id |
/// |---|---|---|
/// | PUBLIC  | **仅** PublicSceneChanged | 必须为 0 |
/// | PRIVATE | MovementStarted / MovementCorrected / AoiEnter / AoiUpdate / AoiLeave / AoiRebase | 必须非 0 |
///
/// `PublicSceneChanged` **只走 PUBLIC**:公共状态若同时出现在两条流上,
/// 同一状态会落在两个不同水位,客户端无从判断以哪条为准(V-E5)。
///
/// Room Publish 是**全订阅者广播**:把 AoiEnter 放进 PUBLIC 会把某人的
/// 视野内容播给全场。发送方**必须**校验本矩阵;接收方收到
/// `PUBLIC + 非 PublicSceneChanged` 时**必须丢弃整批**并拉 snapshot。
table SceneEventBatchEnvelope {
  protocol_version:uint;
  scene_ref:SceneRef;
  visibility:Visibility;
  recipient_role_id:ulong;   // 仅 PRIVATE
  batch_id:ulong;
  chunk_index:ushort;
  chunk_count:ushort;        // 收齐即完整,不依赖尾帧标志
  first_stream_seq:ulong;
  last_stream_seq:ulong;
  events:[SceneEvent];
}
root_type SceneEventBatchEnvelope;
file_identifier "MSE1";
